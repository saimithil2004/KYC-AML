# =============================================================================
# AML/KYC Compliance Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ─── Environment ──────────────────────────────────────────────────────────────
ENV=development
# ENV=production

# ─── REQUIRED SECURITY SECRETS ────────────────────────────────────────────────
# MUST be set before starting the application.
# Minimum 32 characters. Use different values for each environment.
SECRET_KEY=
ENCRYPTION_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://compliance_admin:STRONG_PASSWORD_HERE@postgres:5432/aml_compliance_db
DATABASE_REPLICA_URL=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# ─── PEP Provider ─────────────────────────────────────────────────────────────
# Select PEP screening provider. Leave blank for auto-detection from API keys below.
# Options: opensanctions | worldcheck | dowjones | mock
PEP_PROVIDER=

# ─── Sanctions Provider ───────────────────────────────────────────────────────
# Select Sanctions screening provider. Leave blank for auto-detection.
# Options: opensanctions | ofac | worldcheck | dowjones | mock
SANCTIONS_PROVIDER=

# ─── OpenSanctions (https://opensanctions.org) ────────────────────────────────
# Covers 50+ PEP and Sanctions lists including UN, EU, OFAC, UK HMT.
# Free tier available. Enterprise tier recommended for production.
OPEN_SANCTIONS_API_KEY=
OPEN_SANCTIONS_BASE_URL=https://api.opensanctions.org
OPEN_SANCTIONS_TIMEOUT=10
OPEN_SANCTIONS_CACHE_TTL=3600

# ─── OFAC (US Treasury) ───────────────────────────────────────────────────────
# OFAC SDN (Specially Designated Nationals) list screening.
# Register at: https://api.ofac-api.com
OFAC_API_KEY=
OFAC_API_SEARCH_URL=https://api.ofac-api.com/v2/search
OFAC_MIN_SCORE=70.0
OFAC_TIMEOUT=10
OFAC_CACHE_TTL=3600

# ─── World-Check One (Refinitiv / LSEG) ───────────────────────────────────────
# Enterprise PEP and Sanctions screening.
# Contact Refinitiv sales for credentials.
WORLD_CHECK_API_KEY=
WORLD_CHECK_API_SECRET=
WORLD_CHECK_BASE_URL=https://rms-world-check-one-api-pilot.thomsonreuters.com/v2
WORLD_CHECK_GROUP_ID=
WORLD_CHECK_TIMEOUT=15
WORLD_CHECK_CACHE_TTL=3600

# ─── Dow Jones Risk & Compliance ──────────────────────────────────────────────
# Enterprise risk data screening.
# Contact Dow Jones sales for credentials.
DOW_JONES_API_KEY=
DOW_JONES_API_SECRET=
DOW_JONES_BASE_URL=https://api.dowjones.com/risk-and-compliance/v1
DOW_JONES_TOKEN_URL=https://accounts.dowjones.com/oauth2/v1/token
DOW_JONES_TIMEOUT=15
DOW_JONES_CACHE_TTL=3600

# ─── Companies House (UK) ─────────────────────────────────────────────────────
# UK company registration verification.
# Register at: https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_TIMEOUT=10
COMPANIES_HOUSE_CACHE_TTL=1800

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Gemini is used by InvestigationAgent for narrative generation.
# Falls back to deterministic templates if not set.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true

# ─── Upload & Storage ─────────────────────────────────────────────────────────
UPLOAD_DIR=/app/shared_docs
MAX_UPLOAD_SIZE_MB=10

# ─── Token Expiry ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── DevOps ───────────────────────────────────────────────────────────────────
KUBERNETES_NAMESPACE=aml-compliance
DOCKER_IMAGE_VERSION=16.0.0
GIT_COMMIT=unknown
PROMETHEUS_METRICS_ENABLED=true
