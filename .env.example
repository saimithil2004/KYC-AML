# =============================================================================
# AML/KYC Compliance Platform — Root Environment Variables
# =============================================================================
# This file documents environment variables used by Docker Compose.
# Copy to .env and fill in all values before running docker-compose up.
# NEVER commit .env to version control.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
ENV=development

# ─── REQUIRED SECURITY SECRETS ────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ENCRYPTION_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=aml_compliance_db
POSTGRES_USER=compliance_admin
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://compliance_admin:CHANGE_ME@postgres:5432/aml_compliance_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Screening Provider API Keys ──────────────────────────────────────────────
OPEN_SANCTIONS_API_KEY=
OFAC_API_KEY=
WORLD_CHECK_API_KEY=
WORLD_CHECK_API_SECRET=
WORLD_CHECK_GROUP_ID=
DOW_JONES_API_KEY=
DOW_JONES_API_SECRET=
COMPANIES_HOUSE_API_KEY=

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── Provider Selection (optional) ────────────────────────────────────────────
PEP_PROVIDER=
SANCTIONS_PROVIDER=
